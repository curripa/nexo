---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkButton from '../components/LinkButton.astro';
import QRCode from '../components/QRCode.astro';
import Footer from '../components/Footer.astro';
import CollapsibleAlbums from '../components/CollapsibleAlbums.astro';
import config from '../data/config.json';
import linksData from '../data/generated/links.json';

export async function getStaticPaths() {
  const data = linksData as any;
  return data.bands.map((b: any) => ({ params: { group: b.id }, props: { band: b } }));
}

const { band } = Astro.props as { band: any };
const curripaOrigin = (config as any).curripaOrigin.replace(/\/+$/, '');
const curripaAnchor = `${curripaOrigin}/#${band.id}`;
const bandcampMusic = band.bandcampUrl || null;
const groupLinksUrl = `${curripaOrigin}/nexo/${band.id}`;
const albums = band.albums || [];
---
<BaseLayout title={band.name} description={`Enlaces de ${band.name}`}>
  <main class="min-h-[100dvh] relative z-10 flex flex-col items-center px-4 py-2">
    <div class="w-full max-w-md flex-1 flex flex-col items-center justify-between gap-2 min-h-0 py-1">
      <a href="/nexo/" class="flex flex-col items-center hover:opacity-70 transition-opacity shrink-0" aria-label="Nexo">
        <img src={`${curripaOrigin}/SVG/LogoCurripa.svg`} alt="Curripa" class="h-20 w-auto" />
      </a>

      <a href={curripaAnchor} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center gap-2 w-full hover:opacity-70 transition-opacity py-3 shrink-0" aria-label={`Ver ${band.name} en curripa.github.io`}>
        {band.logoUrl ? (
          <img src={band.logoUrl} alt={band.name} class="max-h-[14vh] sm:max-h-28 w-auto max-w-xs object-contain" />
        ) : (
          <h1 class="font-heading text-3xl sm:text-4xl tracking-widest">{band.name}</h1>
        )}
      </a>

      <div class="w-full flex flex-col items-center gap-1.5 pt-2 mt-2 shrink-0">
        <a href={curripaAnchor} target="_blank" rel="noopener noreferrer" class="block hover:opacity-70 transition-opacity" aria-label="Ver en curripa.github.io">
          <img src={`${curripaOrigin}/SVG/Curripa.svg`} alt="Curripa" class="h-7 w-auto" />
        </a>
        {bandcampMusic ? (
          <a href={bandcampMusic} target="_blank" rel="noopener noreferrer" class="font-heading text-3xl tracking-[0.35em] hover:opacity-70 transition-opacity block translate-x-[0.175em]" aria-label="Bandcamp">BANDCAMP</a>
        ) : (
          <p class="text-center text-xs opacity-50 border border-current/20 py-2">Bandcamp no disponible</p>
        )}
      </div>

      <div class="w-full hidden">
        <CollapsibleAlbums albums={albums} />
      </div>

      <div class="flex-1 flex flex-col items-center justify-center min-h-0 py-1 w-full">
        <QRCode value={groupLinksUrl} label="" />
      </div>
      <Footer />
    </div>
  </main>
</BaseLayout>
